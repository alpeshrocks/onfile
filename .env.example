# Onfile runs with zero configuration for local development:
# with no DATABASE_URL it uses an embedded Postgres (PGlite) stored in ./.data
# and with no RESEND_API_KEY every email is captured in the in-app Outbox.

# Public base URL used in signing links and emails.
APP_URL=http://localhost:3000

# 32+ random characters. Encrypts signing tokens at rest and signs webhook secrets.
# Generate one with: openssl rand -base64 48
APP_SECRET=

# Postgres connection string (Neon, Supabase, RDS, ...). Required in hosted environments.
DATABASE_URL=

# Optional: real email delivery through Resend. Without it, emails land in the Outbox only.
RESEND_API_KEY=
EMAIL_FROM="Onfile <agreements@example.com>"

# Protects /api/cron/tick (reminders and expiry). Vercel Cron sends it automatically.
CRON_SECRET=
